<mujoco model="balance">
  <worldbody>
    <body name="robot_body">
        <joint name="robot_body_joint" type="free"/>
    
        <geom name="motor_base" type="box" size="0.1 0.08 0.08" pos="0 0 0.05" rgba="0.1 0.1 0.1 1" mass="4.0"/>

        <geom name="tier_1" type="box" size="0.25 0.2 0.02" pos="0 0 0.18" rgba="0.2 0.3 0.5 1" mass="2.0"/>
        
        <geom name="tier_2" type="box" size="0.25 0.2 0.02" pos="0 0 0.43" rgba="0.2 0.3 0.5 1" mass="2.0"/>
        
        <geom name="tier_3" type="box" size="0.25 0.2 0.02" pos="0 0 0.68" rgba="0.2 0.3 0.5 1" mass="2.0"/>
        
        <geom name="col_1" type="cylinder" size="0.015 0.25" pos="0.22 0.17 0.43" rgba="0.7 0.7 0.7 1" mass="0.5"/>
        <geom name="col_2" type="cylinder" size="0.015 0.25" pos="-0.22 0.17 0.43" rgba="0.7 0.7 0.7 1" mass="0.5"/>
