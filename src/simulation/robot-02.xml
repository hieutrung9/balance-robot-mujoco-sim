            <joint name="torso_l_wheel" type="hinge" pos="0 0 0" axis="-1 0 0" actuatorfrcrange="-50 50" damping="0.1"/>
            <geom name="l_wheel_geom" size="0.12 0.04" quat="0.707107 0 0.707107 0" type="cylinder" material="wheel_material"/>
        </body>

        <body name="r_wheel" pos="0.28 0 0.034">
